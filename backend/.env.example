# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model used by the agent (recommended default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Read-only PostgreSQL connection string for agent execution
# In Docker Compose, backend connects to postgres:5432. For local host dev, use localhost:5433.
DATABASE_URL=postgresql://agent_readonly:Mb5xcxCL8hoAygMr@localhost:5433/postgres

# Admin database URL (only used by seed script for initial INSERT/TRUNCATE)
DATABASE_ADMIN_URL=postgresql://postgres:postgrespassword@localhost:5433/postgres

# CORS origin for local dev — the Vite frontend
FRONTEND_ORIGIN=http://localhost:5173
