# Google AI Studio API key — get one free at https://aistudio.google.com/apikey
# No credit card needed. Sign in with any Google account.
GEMINI_API_KEY=your-gemini-api-key-here

# Model used by the agent. Swap this if you hit rate limits or want more
# reasoning power — nothing else in the code needs to change.
# Good free-tier options as of mid-2026: gemini-3.1-flash-lite (fast/cheap,
# default here), gemini-3-flash or gemini-3.5-flash (more reasoning headroom
# if flash-lite starts missing tool calls on complex multi-step questions).
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase Postgres connection string for the AGENT_READONLY role created in
# schema.sql — never put the service-role or postgres superuser string here.
# Find it in Supabase: Project Settings -> Database -> Connection string
# (URI, "Transaction" pooler mode), then swap in the readonly user/password.
DATABASE_URL=postgresql://agent_readonly:CHANGE_ME@db.xxxxxxxx.supabase.co:5432/postgres

# CORS origin for local dev — the Vite frontend
FRONTEND_ORIGIN=http://localhost:5173
